# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Django cryptographic signing key. Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

# Debug mode. Use True only for local development, never in production.
DJANGO_DEBUG=True

# Comma-separated list of hosts/domains the site can serve.
# Leave empty for local development; required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=
